APP_ENV=dev
INFERENCE_PROVIDER=local_onnx
MODEL_PATH=models/ppe.onnx
PERSON_MODEL_PATH=models/person.onnx
# Dual-model (true) vs single PPE-only model (false). See benchmark §6.
USE_SEPARATE_PERSON_MODEL=true
# Adaptive PPE zoom on 1-2 workers; off = old full-frame inference.
# Keeps no_helmet/no_vest violation thresholds unchanged.
PPE_ROI_MODE=auto
# Local ONNX providers, comma-separated (e.g. CoreMLExecutionProvider on Mac:
# measured 16 ms vs 437 ms CPU on bus.jpg). Empty = CPU. Fact in system/info.
ONNX_PROVIDERS=
CONFIDENCE_THRESHOLD=0.4
INFERENCE_THREADS=2
TARGET_FPS=5
INCIDENT_CONFIRM_SECONDS=2.0
INCIDENT_CLEAR_SECONDS=2.0
TEMPORAL_WINDOW=4
TEMPORAL_REQUIRED=3
# Terminal incidents older than N days are purged with snapshots on startup.
# 0 = keep forever.
SNAPSHOT_RETENTION_DAYS=0

# Per-class detection thresholds (sprint accuracy §1). Absence classes are
# stricter on purpose: weak no_helmet must not become a violation.
PERSON_THRESHOLD=0.45
HELMET_THRESHOLD=0.50
NO_HELMET_THRESHOLD=0.60
VEST_THRESHOLD=0.50
NO_VEST_THRESHOLD=0.60
# Display floor: below it detections are dropped; between floor and the
# per-class threshold they are shown flagged weak (never violations).
DISPLAY_FLOOR=0.25

# MVP scope per project description §11: helmet + vest + danger zone.
# Mask (respirator) and smoking are post-MVP extensions, off by default.
RULE_HELMET=true
RULE_VEST=true
RULE_MASK=false
RULE_SMOKING=false
RULE_ZONE_ENABLED=false

# LinQ accelerator (online access from organizers). Empty = dev fallback:
# LinqProvider reuses local ONNX weights keeping the Detection contract.
# At the hackathon set e.g. LINQ_ENDPOINT=https://linq.example.com
LINQ_ENDPOINT=
LINQ_API_KEY=
LINQ_TIMEOUT_SECONDS=8
LINQ_MODEL=ppe-linq
# Vendor ONNX execution provider name(s), comma-separated by priority.
# Actual session providers are reported in GET /api/v1/system/info.
LINQ_PROVIDERS=LinQExecutionProvider

# All relative paths resolve from the repository root.
DATABASE_URL=sqlite:///./data/safety.db
DATA_DIR=data

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone-as-camera (run.py --lan sets these automatically):
# public HTTPS URL shown as QR in the UI; LAN origin allowed for API calls.
PUBLIC_URL=
EXTRA_ORIGINS=
# Demo access token for LAN mode (run.py --lan generates one per launch).
# When set, /api (except /health and /system/info) requires ?token=/header.
API_TOKEN=

# --- Demo-validated profile (measured, opt-in; defaults above stay standard) ---
# Uncomment as a block to reproduce the validated runs (V4 + ROI off). This
# does NOT silently replace the standard Hexmon model — uncomment deliberately.
# MODEL_PATH=models/ppe-v4.onnx
# PPE_ROI_MODE=off
# USE_SEPARATE_PERSON_MODEL=true
# Benchmarks: training/bench_runtime_prod/ (25.62 FPS CoreML, 12.5 min),
# training/eval_ab_v4_final/ (A/B vs V3-clean). NO-GO for production use
# without violation-footage proof; see WORKLOG.
